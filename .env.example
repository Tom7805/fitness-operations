# Sao chép thành .env rồi điền giá trị thật. Không commit file .env.

# --- Cơ sở dữ liệu ---
DB_NAME=fitness_operations
DB_USERNAME=fitness
DB_PASSWORD=fitness
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/fitness_operations

# --- Bảo mật ---
# Khóa ký mã truy cập: chuỗi Base64 của ít nhất 32 byte ngẫu nhiên, ví dụ: openssl rand -base64 48
# Bắt buộc ở staging/prod; profile dev có khóa mặc định riêng.
JWT_SECRET=

# Origin của giao diện được phép gọi API (phân tách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:5173
