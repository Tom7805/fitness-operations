# Sao chép thành .env rồi điền giá trị thật. Không commit file .env.

# --- Cơ sở dữ liệu: MySQL 8 trên máy (tạo database và tài khoản bằng scripts/mysql-dev-setup.sql) ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/fitness_operations?characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=fitness
SPRING_DATASOURCE_PASSWORD=fitness

# Database dành riêng cho kiểm thử tự động (bị xóa sạch mỗi lần chạy ./mvnw verify)
TEST_DB_URL=jdbc:mysql://localhost:3306/fitness_operations_test?characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
TEST_DB_USERNAME=fitness
TEST_DB_PASSWORD=fitness

# --- Bảo mật ---
# Khóa ký mã truy cập: chuỗi Base64 của ít nhất 32 byte ngẫu nhiên, ví dụ: openssl rand -base64 48
# Bắt buộc ở staging/prod; profile dev có khóa mặc định riêng.
JWT_SECRET=

# Origin của giao diện được phép gọi API (phân tách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:5173