# Normalize line endings: store and check out text files with LF
* text=auto eol=lf

# Windows-only scripts must keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must always be LF (run inside Linux containers / CI)
*.sh text eol=lf
mvnw text eol=lf

# Source & config
*.java text diff=java
*.ts text
*.tsx text
*.js text
*.json text
*.yml text
*.yaml text
*.xml text
*.properties text
*.sql text
*.md text diff=markdown
*.html text diff=html
*.css text diff=css
Dockerfile text

# Binary files
*.jar binary
*.war binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.svg text
